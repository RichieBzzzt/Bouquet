  "tokenColors": [
    {
      "name": "Global settings",
      "settings": {
        "background": "#fbfefc",
        "foreground": "#19352f"
      }
    },
    {
      "name": "Comments",
      "scope": ["comment", "comment.line", "comment.block"],
      "settings": {
        "foreground": "#527067",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#ad3e72"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"],
      "settings": {
        "foreground": "#8a6500"
      }
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp", "constant.regexp"],
      "settings": {
        "foreground": "#006b63"
      }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage", "storage.type", "keyword.control", "keyword.operator"],
      "settings": {
        "foreground": "#6656a6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Classes and types",
      "scope": ["entity.name.class", "entity.name.type", "support.type", "support.class"],
      "settings": {
        "foreground": "#ad3e72"
      }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#1f6f63"
      }
    },
    {
      "name": "Tags and attributes",
      "scope": ["entity.name.tag", "meta.tag", "entity.other.attribute-name"],
      "settings": {
        "foreground": "#1f6f63"
      }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": {
        "foreground": "#365b53"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": ["punctuation", "meta.brace", "meta.delimiter", "keyword.operator"],
      "settings": {
        "foreground": "#527067"
      }
    },
    {
      "name": "Markup headings and links",
      "scope": ["markup.heading", "markup.underline.link", "markup.bold", "markup.italic"],
      "settings": {
        "foreground": "#6656a6"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
      "settings": {
        "foreground": "#a33b66",
        "fontStyle": "underline"
      }
    }
  ]
}
